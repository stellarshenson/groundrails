  "predicate": {
    "head": "grounding scalar (task_head) - the shipped ground() support score",
    "label_rule_in_loader": "label = 1.0 iff labels.list.len() == 0, i.e. the row carries NO annotated hallucination span; else 0.0",
    "corpus_predicate": "RAGTruth response-level faithfulness: a response is labelled unsupported iff a human annotator (spans inherited from the English original and re-aligned after machine translation) marked ANY span of it as evident_conflict or baseless_info against the prompt's source material",
